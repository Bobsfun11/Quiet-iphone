{
  "expo": {
    "name": "Quiet",
    "slug": "quiet-social",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "scheme": "quiet-social",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quietsocial.personal",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#151A17",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
