{
  "name": "quiet-social",
  "version": "1.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "verify": "npm run typecheck && npm test && npm run test:browser",
    "export:ios": "expo export --platform ios",
    "build:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "build:testflight": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --latest",
    "preview": "expo start --web --port 8081",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.24",
    "expo-dev-client": "~58.0.19",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.3.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
